# --- Required -----------------------------------------------------------
# PostgreSQL connection string (Neon serverless or any Postgres)
DATABASE_URL=postgresql://user:password@host:5432/cadet

# OpenAI API key — powers chat completions and vector embeddings for RAG
OPENAI_API_KEY=sk-...

# --- Optional: multi-tenant mode ----------------------------------------
# Per-org Supabase projects. When an orgId is NOT listed here, the server
# automatically falls back to single-tenant mode using the local database,
# so the AI assistant works out of the box without this.
# TENANT_SUPABASE_JSON='[{"orgId":"<uuid>","supabaseUrl":"https://...","supabaseServiceRoleKey":"...","planTier":"pilot"}]'

# --- Optional: integrations ---------------------------------------------
# Microsoft Teams / OneDrive OAuth
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Slack OAuth
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=

# Google Drive OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
